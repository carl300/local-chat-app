# Copy this file to .env for local development.
# Bedrock uses your normal AWS credentials (aws configure / aws sso login).
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-5-5

# Leave these empty to skip sign-in locally. Set them (from `terraform output`) to test sign-in.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Set to 1 to get echo replies without calling Bedrock.
# AI_DISABLED=1
